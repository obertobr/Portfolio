---
import '../styles/global.css';
import { getSiteOrigin } from '../utils/siteOrigin';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogType?: 'website' | 'profile';
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const { 
  title, 
  description = "Portfólio de Rafael Eduardo Azzi Lopes (@obertobr) — Engenheiro de Software Full Stack e Dados com experiência em Python, TypeScript, React, Node.js, PHP, Delphi e bancos de dados relacionais.",
  keywords = "Rafael Eduardo Azzi Lopes, obertobr, Engenheiro de Software, Desenvolvedor Full Stack, Python, TypeScript, JavaScript, React, Node.js, PHP, Delphi, Lazarus, Engenharia de Dados, FATEC, Bragança Paulista, Portfólio",
  ogType = "profile",
  ogImage = "/og.png",
  structuredData
} = Astro.props;

const siteOrigin = getSiteOrigin(Astro.request, Astro.url);
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const imageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Rafael Eduardo Azzi Lopes (obertobr)">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="theme-color" content="#141416">

  <link rel="canonical" href={canonicalUrl}>
  <link rel="icon" type="image/png" href="/imgs/HD.png">
  <link rel="apple-touch-icon" href="/imgs/HD.png">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Rafael Eduardo Azzi Lopes (obertobr)">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:secure_url" content={imageUrl}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Rafael Eduardo Azzi Lopes (obertobr) — Engenheiro de Software">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@obertobr">
  <meta name="twitter:creator" content="@obertobr">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body bgcolor="#141416" text="#e2e8f0" link="#38bdf8" vlink="#38bdf8">
  <canvas id="life-canvas" aria-hidden="true"></canvas>
  <slot />

  <script is:inline>
    (function () {
      var canvas = document.getElementById('life-canvas');
      if (!canvas || !canvas.getContext || !window.requestAnimationFrame || typeof Uint8Array === 'undefined') {
        return;
      }
      var ctx = canvas.getContext('2d');
      if (!ctx) return;

      var cellSize = 10;
      var stepInterval = 130;
      var cols = 0;
      var rows = 0;
      var current = new Uint8Array(0);
      var next = new Uint8Array(0);
      var tick = 0;
      var lastTime = 0;

      function initGrid() {
        canvas.width = window.innerWidth || document.documentElement.clientWidth || 1024;
        canvas.height = window.innerHeight || document.documentElement.clientHeight || 768;
        cols = Math.ceil(canvas.width / cellSize);
        rows = Math.ceil(canvas.height / cellSize);
        var total = cols * rows;
        current = new Uint8Array(total);
        next = new Uint8Array(total);

        for (var i = 0; i < total; i++) {
          if (Math.random() < 0.12) {
            current[i] = 1;
          }
        }
      }

      function spawnGlider(x, y) {
        var pattern = [
          [0, 1], [1, 2], [2, 0], [2, 1], [2, 2]
        ];
        for (var i = 0; i < pattern.length; i++) {
          var dx = pattern[i][0];
          var dy = pattern[i][1];
          var c = (x + dx + cols) % cols;
          var r = (y + dy + rows) % rows;
          current[r * cols + c] = 1;
        }
      }

      if (window.addEventListener) {
        window.addEventListener('resize', initGrid);
        window.addEventListener('click', function (e) {
          var c = Math.floor(e.clientX / cellSize);
          var r = Math.floor(e.clientY / cellSize);
          for (var dr = -1; dr <= 1; dr++) {
            for (var dc = -1; dc <= 1; dc++) {
              if (Math.random() < 0.75) {
                var nc = (c + dc + cols) % cols;
                var nr = (r + dr + rows) % rows;
                current[nr * cols + nc] = 1;
              }
            }
          }
        });
      }
      initGrid();

      function step() {
        var aliveCount = 0;
        for (var r = 0; r < rows; r++) {
          var top = (r === 0 ? rows - 1 : r - 1) * cols;
          var mid = r * cols;
          var bot = (r === rows - 1 ? 0 : r + 1) * cols;

          for (var c = 0; c < cols; c++) {
            var left = c === 0 ? cols - 1 : c - 1;
            var right = c === cols - 1 ? 0 : c + 1;

            var count = (
              (current[top + left] > 0 ? 1 : 0) +
              (current[top + c] > 0 ? 1 : 0) +
              (current[top + right] > 0 ? 1 : 0) +
              (current[mid + left] > 0 ? 1 : 0) +
              (current[mid + right] > 0 ? 1 : 0) +
              (current[bot + left] > 0 ? 1 : 0) +
              (current[bot + c] > 0 ? 1 : 0) +
              (current[bot + right] > 0 ? 1 : 0)
            );

            var idx = mid + c;
            var state = current[idx];

            if (state > 0) {
              if (count === 2 || count === 3) {
                next[idx] = Math.min(state + 1, 10);
                aliveCount++;
              } else {
                next[idx] = 0;
              }
            } else {
              if (count === 3) {
                next[idx] = 1;
                aliveCount++;
              } else {
                next[idx] = 0;
              }
            }
          }
        }

        var temp = current;
        current = next;
        next = temp;

        if (tick % 60 === 0 || aliveCount < 25) {
          var rx = Math.floor(Math.random() * cols);
          var ry = Math.floor(Math.random() * rows);
          spawnGlider(rx, ry);
        }
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
        ctx.lineWidth = 1;
        ctx.beginPath();

        for (var r = 0; r < rows; r++) {
          var rowOffset = r * cols;
          var y = r * cellSize;
          var topRow = (r === 0 ? rows - 1 : r - 1) * cols;
          var botRow = (r === rows - 1 ? 0 : r + 1) * cols;

          for (var c = 0; c < cols; c++) {
            if (current[rowOffset + c] > 0) {
              var x = c * cellSize;
              var left = c === 0 ? cols - 1 : c - 1;
              var right = c === cols - 1 ? 0 : c + 1;

              if (current[topRow + c] === 0) {
                ctx.moveTo(x, y);
                ctx.lineTo(x + cellSize, y);
              }
              if (current[botRow + c] === 0) {
                ctx.moveTo(x, y + cellSize);
                ctx.lineTo(x + cellSize, y + cellSize);
              }
              if (current[rowOffset + left] === 0) {
                ctx.moveTo(x, y);
                ctx.lineTo(x, y + cellSize);
              }
              if (current[rowOffset + right] === 0) {
                ctx.moveTo(x + cellSize, y);
                ctx.lineTo(x + cellSize, y + cellSize);
              }
            }
          }
        }
        ctx.stroke();
      }

      function loop(timestamp) {
        window.requestAnimationFrame(loop);
        if (timestamp - lastTime < stepInterval) return;
        lastTime = timestamp;
        tick++;
        step();
        draw();
      }

      window.requestAnimationFrame(loop);
    })();
  </script>
</body>
</html>
