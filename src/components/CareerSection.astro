---
import careerData from '../data/career.json';
---

<section class="career-section">
  <div class="section-title">
    <span>2.0 Histórico de Atuação Profissional</span>
  </div>

  <table class="spec-table career-table">
    <thead>
      <tr>
        <th style="width: 150px;">Período</th>
        <th style="width: 210px;">Papel / Instituição</th>
        <th>Escopo & Tecnologias</th>
      </tr>
    </thead>
    <tbody>
      {careerData.map((item) => (
        <tr class="career-row">
          <td class="career-period">{item.period}</td>
          <td class="career-role-org">
            <strong class="career-role">{item.role}</strong>
            <div class="career-org">{item.organization}</div>
          </td>
          <td class="career-desc">{item.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .career-period {
    color: var(--cyan);
    font-weight: bold;
  }

  .career-role {
    color: #fff;
  }

  .career-org {
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
  }

  .career-desc {
    color: var(--muted);
  }

  @media screen and (max-width: 680px) {
    .career-table,
    .career-table tbody,
    .career-table tr,
    .career-table td {
      display: block;
      width: 100% !important;
    }

    .career-table thead {
      display: none;
    }

    .career-row {
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
    }

    .career-row:last-child {
      border-bottom: none;
    }

    .career-period {
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--cyan) !important;
      font-weight: bold;
      padding: 0 0 4px 0 !important;
      border: none !important;
    }

    .career-role-org {
      padding: 0 0 6px 0 !important;
      border: none !important;
    }

    .career-role {
      font-size: 13px;
      color: #fff;
      display: block;
      line-height: 1.3;
    }

    .career-org {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .career-desc {
      font-size: 12px;
      line-height: 1.55;
      color: var(--muted) !important;
      padding: 0 !important;
      border: none !important;
    }
  }
</style>
