---
import { getProjects } from '../services/portfolioData.js';

const projectsData = await getProjects();
---

<section class="projects-section" aria-labelledby="sec-projects">
  <h2 id="sec-projects" class="section-title">
    <span>5.0 Projetos</span>
    <a href="/projetos" class="section-header-link">Todos projetos ↗</a>
  </h2>

  <div class="projects-grid">
    {projectsData.featured.map((proj, idx) => (
      <article class="project-card">
        <div class="project-card-content">
          <div class="project-card-header">
            <div class="project-title-wrap">
              <span class="project-idx">0{idx + 1}</span>
              <h3 class="project-title">{proj.name}</h3>
            </div>
          </div>

          <div class="project-stack-tags">
            {proj.stack.split(' • ').map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>

          <p class="project-desc">{proj.description}</p>
        </div>

        <div class="project-footer">
          <a href={proj.url} target="_blank" rel="noopener noreferrer" class="project-github-link">
            Ver no GitHub ↗
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (function () {
    if (!document.querySelectorAll) return;

    function syncProjectCardHeights() {
      var cards = document.querySelectorAll('.project-card');
      if (!cards.length) return;
      for (var i = 0; i < cards.length; i++) {
        cards[i].style.height = 'auto';
      }
      var maxHeight = 0;
      for (var j = 0; j < cards.length; j++) {
        if (cards[j].offsetHeight > maxHeight) {
          maxHeight = cards[j].offsetHeight;
        }
      }
      if (maxHeight > 0) {
        for (var k = 0; k < cards.length; k++) {
          cards[k].style.height = maxHeight + 'px';
        }
      }
    }

    syncProjectCardHeights();
    if (window.addEventListener) {
      window.addEventListener('resize', syncProjectCardHeights);
    }
  })();
</script>

<style>
  .section-header-link {
    font-size: 11px;
    font-weight: normal;
    color: var(--cyan);
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0;
  }

  .section-header-link:hover {
    text-decoration: underline;
  }

  .projects-grid {
    margin: 16px 0 24px 0;
  }

  .project-card {
    background: #101013;
    border: 1px solid var(--border);
    border-top: 2px solid #27272a;
    padding: 12px 14px;
    display: inline-block;
    vertical-align: top;
    width: 48%;
    margin-right: 1.5%;
    margin-bottom: 14px;
    min-height: 135px;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  @supports (display: grid) {
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .project-card {
      width: auto;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }

  .project-card:hover {
    border-color: var(--cyan);
    border-top-color: var(--cyan);
    background: #131317;
  }

  .project-card-header {
    margin-bottom: 6px;
  }

  .project-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .project-idx {
    font-size: 11px;
    font-weight: bold;
    color: var(--cyan);
    font-family: var(--font-mono);
    margin-right: 6px;
  }

  .project-title {
    font-size: 13px;
    font-weight: bold;
    color: #fff;
    line-height: 1.3;
    display: inline;
  }

  .project-stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 8px;
  }

  .project-tag {
    font-size: 10px;
    color: var(--cyan);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.18);
    padding: 1px 6px;
    display: inline-block;
    margin-right: 4px;
  }

  @supports (gap: 5px) {
    .project-idx,
    .project-tag {
      margin-right: 0;
    }
  }

  .project-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .project-footer {
    text-align: right;
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
  }

  .project-github-link {
    font-size: 11px;
    color: var(--cyan);
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
  }

  .project-github-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 680px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      width: 100%;
      margin-right: 0;
    }
  }

  @media print {
    .projects-section {
      display: none !important;
    }
  }
</style>
