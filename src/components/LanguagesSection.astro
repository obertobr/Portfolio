---
import { getLanguages } from '../services/portfolioData.js';

const rawLanguages = await getLanguages();
const allLanguages = rawLanguages;

const top5 = rawLanguages.slice(0, 5);
const remaining = rawLanguages.slice(5);

const printLanguages = [...top5];
if (remaining.length > 0) {
  const othersPct = Number(remaining.reduce((sum, l) => sum + l.percentage, 0).toFixed(1));
  const othersProjects = remaining.reduce((sum, l) => sum + l.projects, 0);
  printLanguages.push({
    name: 'Outros',
    percentage: othersPct,
    color: '#eeeeee',
    projects: othersProjects
  });
}

const printGrayscaleShades = [
  '#000000',
  '#333333',
  '#666666',
  '#999999',
  '#cccccc',
  '#eeeeee'
];
---

<section class="languages-section" aria-labelledby="sec-languages">
  <h2 id="sec-languages" class="section-title">
    <span>3.0 Linguagens</span>
  </h2>

  <div class="lang-bar-container screen-bar" role="progressbar" aria-label="Distribuição de linguagens">
    {allLanguages.map((lang) => (
      <a 
        href={`/projetos?lang=${encodeURIComponent(lang.name)}`}
        class="lang-bar-segment" 
        style={`width: ${lang.percentage}%; background-color: ${lang.color};`}
        title={`Ver projetos em ${lang.name}: ${lang.percentage}% (${lang.projects} ${lang.projects === 1 ? 'projeto' : 'projetos'})`}
      />
    ))}
  </div>

  <div class="lang-bar-container print-bar" role="progressbar" aria-label="Distribuição de linguagens no PDF">
    {printLanguages.map((lang, idx) => (
      <div 
        class="lang-bar-segment" 
        style={`width: ${lang.percentage}%; background-color: ${printGrayscaleShades[idx] || '#eeeeee'}; ${idx === printLanguages.length - 1 ? 'border-right: 1px solid #999;' : ''}`}
        title={`${lang.name}: ${lang.percentage}%`}
      />
    ))}
  </div>

  <div class="lang-grid screen-grid">
    {allLanguages.map((lang) => (
      <a href={`/projetos?lang=${encodeURIComponent(lang.name)}`} class="lang-card" title={`Filtrar projetos por ${lang.name}`}>
        <div class="lang-card-header">
          <div class="lang-name-block">
            <span class="lang-dot" style={`background-color: ${lang.color};`} />
            <span>{lang.name}</span>
          </div>
          <div class="lang-stats">
            <span class="lang-count">{lang.projects} {lang.projects === 1 ? 'projeto' : 'projetos'}</span>
            <span class="lang-sep">•</span>
            <span class="lang-pct">{lang.percentage.toFixed(1)}%</span>
          </div>
        </div>

        <div class="lang-progress-track">
          <div 
            class="lang-progress-fill" 
            style={`width: ${lang.percentage}%; background-color: ${lang.color};`}
          />
        </div>
      </a>
    ))}
  </div>

  <div class="lang-grid print-grid">
    {printLanguages.map((lang, idx) => (
      <div class="lang-card print-lang-card">
        <div class="lang-card-header">
          <div class="lang-name-block">
            <span 
              class="lang-dot" 
              style={`background-color: ${printGrayscaleShades[idx] || '#eeeeee'}; ${idx === printLanguages.length - 1 ? 'border: 0.5px solid #888;' : ''}`} 
            />
            <span>{lang.name}</span>
          </div>
          <div class="lang-stats">
            <span class="lang-count">{lang.projects} {lang.projects === 1 ? 'projeto' : 'projetos'}</span>
            <span class="lang-sep">•</span>
            <span class="lang-pct">{lang.percentage.toFixed(1)}%</span>
          </div>
        </div>

        <div class="lang-progress-track">
          <div 
            class="lang-progress-fill" 
            style={`width: ${lang.percentage}%; background-color: ${printGrayscaleShades[idx] || '#eeeeee'}; ${idx === printLanguages.length - 1 ? 'border: 0.5px solid #aaa;' : ''}`}
          />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .lang-bar-container {
    display: flex;
    height: 8px;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    background: #1e1e24;
    border: 1px solid var(--border);
    margin: 16px 0 20px 0;
    gap: 2px;
  }

  .lang-bar-segment {
    height: 100%;
    transition: opacity 0.2s ease;
  }

  .lang-bar-segment:hover {
    opacity: 0.8;
  }

  .lang-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }

  .lang-card {
    border: 1px solid var(--border);
    background: #111113;
    padding: 9px 12px;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .lang-card:hover {
    border-color: var(--cyan);
    background: #15151a;
  }

  .lang-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: 12px;
  }

  .lang-name-block {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: bold;
    color: #fff;
  }

  .lang-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .lang-stats {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-family: var(--font-mono);
  }

  .lang-count {
    color: var(--muted);
  }

  .lang-sep {
    color: var(--border);
  }

  .lang-pct {
    color: var(--cyan);
    font-weight: bold;
  }

  .lang-progress-track {
    width: 100%;
    height: 3px;
    background: #27272a;
    border-radius: 2px;
    overflow: hidden;
  }

  .lang-progress-fill {
    height: 100%;
    border-radius: 2px;
  }

  .print-bar,
  .print-grid {
    display: none !important;
  }

  @media (max-width: 640px) {
    .lang-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .languages-section {
      grid-column: 1 / -1 !important;
      grid-row: 5 !important;
    }

    .screen-bar,
    .screen-grid {
      display: none !important;
    }

    .print-bar {
      display: flex !important;
      height: 8px !important;
      margin: 6px 0 8px 0 !important;
      border: 1px solid #000 !important;
      border-radius: 2px !important;
      background: #f4f4f5 !important;
      gap: 1px !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-bar .lang-bar-segment {
      height: 100% !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 6px !important;
      margin-bottom: 6px !important;
    }

    .print-lang-card {
      border: 1px solid #777 !important;
      background: #fff !important;
      padding: 4px 8px !important;
    }

    .print-lang-card .lang-card-header {
      margin-bottom: 3px !important;
      font-size: 10px !important;
    }

    .print-lang-card .lang-name-block {
      color: #000 !important;
      gap: 5px !important;
      font-weight: bold !important;
    }

    .print-lang-card .lang-dot {
      width: 6px !important;
      height: 6px !important;
      border-radius: 50% !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-lang-card .lang-stats {
      font-size: 9px !important;
      gap: 4px !important;
    }

    .print-lang-card .lang-count {
      color: #444 !important;
    }

    .print-lang-card .lang-pct {
      color: #000 !important;
      font-weight: bold !important;
    }

    .print-lang-card .lang-progress-track {
      height: 3px !important;
      background: #e2e8f0 !important;
      border: 0.5px solid #ccc !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-lang-card .lang-progress-fill {
      height: 100% !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }
</style>
