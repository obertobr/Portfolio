---
import languages from '../data/languages.json';
---

<section>
  <div class="section-title">
    <span>3.0 Linguagens</span>
  </div>

  <div class="lang-bar-container" role="progressbar" aria-label="Distribuição de linguagens">
    {languages.map((lang) => (
      <a 
        href={`/projetos?lang=${encodeURIComponent(lang.name)}`}
        class="lang-bar-segment" 
        style={`width: ${lang.percentage}%; background-color: ${lang.color};`}
        title={`Ver projetos em ${lang.name}: ${lang.percentage}% (${lang.projects} ${lang.projects === 1 ? 'projeto' : 'projetos'})`}
      />
    ))}
  </div>

  <div class="lang-grid">
    {languages.map((lang) => (
      <a href={`/projetos?lang=${encodeURIComponent(lang.name)}`} class="lang-card" title={`Filtrar projetos por ${lang.name}`}>
        <div class="lang-card-header">
          <div class="lang-name-block">
            <span class="lang-dot" style={`background-color: ${lang.color};`} />
            <span>{lang.name}</span>
          </div>
          <div class="lang-stats">
            <span class="lang-count">{lang.projects} {lang.projects === 1 ? 'projeto' : 'projetos'}</span>
            <span class="lang-sep">•</span>
            <span class="lang-pct">{lang.percentage.toFixed(1)}%</span>
          </div>
        </div>

        <div class="lang-progress-track">
          <div 
            class="lang-progress-fill" 
            style={`width: ${lang.percentage}%; background-color: ${lang.color};`}
          />
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .lang-bar-container {
    display: flex;
    height: 8px;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    background: #1e1e24;
    border: 1px solid var(--border);
    margin: 16px 0 20px 0;
    gap: 2px;
  }

  .lang-bar-segment {
    height: 100%;
    transition: opacity 0.2s ease;
  }

  .lang-bar-segment:hover {
    opacity: 0.8;
  }

  .lang-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }

  .lang-card {
    border: 1px solid var(--border);
    background: #111113;
    padding: 9px 12px;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .lang-card:hover {
    border-color: var(--cyan);
    background: #15151a;
  }

  .lang-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: 12px;
  }

  .lang-name-block {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: bold;
    color: #fff;
  }

  .lang-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .lang-stats {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-family: var(--font-mono);
  }

  .lang-count {
    color: var(--muted);
  }

  .lang-sep {
    color: var(--border);
  }

  .lang-pct {
    color: var(--cyan);
    font-weight: bold;
  }

  .lang-progress-track {
    width: 100%;
    height: 3px;
    background: #27272a;
    border-radius: 2px;
    overflow: hidden;
  }

  .lang-progress-fill {
    height: 100%;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .lang-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .lang-card {
      border: 1px solid #000 !important;
      background: #fff !important;
    }
    .lang-name-block,
    .lang-count,
    .lang-pct {
      color: #000 !important;
    }
  }
</style>
