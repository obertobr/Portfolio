<style>
  .margin-sidebar {
    border-right: 1px solid var(--border);
    padding-right: 28px;
  }

  .margin-sidebar-sticky {
    position: sticky;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .margin-photo-box {
    width: 120px;
    height: 120px;
    border: 1px solid var(--cyan);
    padding: 3px;
    background: #000;
  }

  .margin-photo-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(120%) grayscale(40%);
  }

  .margin-caption {
    font-size: 10px;
    color: var(--muted);
    margin-top: 6px;
    line-height: 1.4;
  }

  .margin-note {
    font-size: 11px;
    color: var(--muted);
    border-left: 2px solid var(--cyan);
    padding-left: 10px;
    line-height: 1.5;
  }

  .margin-note strong {
    color: var(--cyan);
    display: block;
    margin-bottom: 2px;
  }

  .social-links-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 5px;
  }

  .social-link-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--cyan);
    text-decoration: none;
    font-size: 11px;
    line-height: 1.4;
  }

  .social-link-item:hover {
    color: #fff;
    text-decoration: underline;
  }

  .social-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .margin-sidebar {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding-right: 0;
      padding-bottom: 24px;
    }

    .margin-sidebar-sticky {
      position: static;
    }
  }

  @media print {
    .margin-sidebar {
      display: contents !important;
    }

    .margin-sidebar-sticky {
      display: contents !important;
    }

    .margin-photo-container,
    .margin-networks {
      display: none !important;
    }

    .margin-contacts {
      grid-column: 2 !important;
      grid-row: 1 !important;
      border: none !important;
      padding: 0 0 2px 16px !important;
      margin: 0 !important;
      font-size: 9.5px !important;
      line-height: 1.35 !important;
      color: #111 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
    }

    .margin-contacts strong {
      display: block !important;
      margin-bottom: 2px !important;
      color: #000 !important;
      font-weight: bold !important;
      letter-spacing: 0.5px !important;
    }

    .margin-education {
      grid-column: 1 / -1 !important;
      grid-row: 2 !important;
      border: none !important;
      border-bottom: 1px solid #000 !important;
      padding: 6px 0 !important;
      margin: 0 0 6px 0 !important;
      font-size: 11.5px !important;
      line-height: 1.35 !important;
      color: #111 !important;
    }

    .margin-education strong {
      color: #000 !important;
      font-weight: bold !important;
      display: inline !important;
      margin-right: 6px !important;
      font-size: 11.5px !important;
    }
  }
</style>
