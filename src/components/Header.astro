---
interface Props {
  title?: string;
  username?: string;
  subtitle?: string;
}

const {
  title = "Rafael Eduardo Azzi Lopes",
  username = "obertobr",
  subtitle = "Engenheiro de Software • Python, TypeScript & Sistemas de Dados • FATEC ADS",
} = Astro.props;
---

<header class="doc-header-block">
  <h1>{title}<span class="doc-username">{username}</span></h1>
  <div class="doc-subtitle">{subtitle}</div>
</header>

<style>
  .doc-username {
    font-size: 0.58em;
    font-weight: normal;
    color: var(--muted);
    margin-left: 5px;
    letter-spacing: 0;
  }

  @media print {
    .doc-username {
      color: #555 !important;
    }
  }
</style>
