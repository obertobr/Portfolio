---
import Layout from '../layouts/Layout.astro';
import { getProjects } from '../services/portfolioData.js';
import { getSiteOrigin } from '../utils/siteOrigin';

const projectsData = await getProjects();

const sortedProjects = [...projectsData.all].sort((a, b) => {
  const dateA = a.updated_at ? new Date(a.updated_at).getTime() : 0;
  const dateB = b.updated_at ? new Date(b.updated_at).getTime() : 0;
  return dateB - dateA;
});

const rawLangFilter = Astro.url.searchParams.get('lang');
const targetLang = rawLangFilter ? rawLangFilter.trim().toLowerCase() : '';

function matchesLanguageFilter(language: string): boolean {
  if (!targetLang) return true;
  const normalized = (language || '').trim().toLowerCase();
  if (targetLang === 'outros') {
    return !['javascript', 'typescript', 'rust', 'php', 'python'].includes(normalized);
  }
  return normalized === targetLang;
}

const visibleCount = sortedProjects.filter((p) => matchesLanguageFilter(p.language)).length;
const countLabel = targetLang
  ? `${visibleCount} DE ${sortedProjects.length} PROJETOS`
  : `TOTAL: ${sortedProjects.length} PROJETOS`;

const siteOrigin = getSiteOrigin(Astro.request, Astro.url);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Repositórios e Projetos — Rafael Eduardo Azzi Lopes (obertobr)",
  "description": "Catálogo completo de repositórios, sistemas e projetos open source desenvolvidos por Rafael Eduardo Azzi Lopes (@obertobr).",
  "url": `${siteOrigin}/projetos`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": sortedProjects.length,
    "itemListElement": sortedProjects.slice(0, 25).map((repo, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "SoftwareSourceCode",
        "name": repo.name,
        "description": repo.description,
        "programmingLanguage": repo.language,
        "codeRepository": repo.url
      }
    }))
  }
};
---

<Layout
  title="Repositórios & Projetos — Rafael Eduardo Azzi Lopes (obertobr)"
  description="Catálogo completo de repositórios, sistemas e projetos open source desenvolvidos por Rafael Eduardo Azzi Lopes (@obertobr) em Python, TypeScript, Rust, PHP e JavaScript."
  ogType="website"
  structuredData={structuredData}
>
  <div class="document-layout">
    <aside class="margin-sidebar">
      <div class="margin-sidebar-sticky">
        <div>
          <a href="/" style="font-weight:bold; font-size:12px;">← Voltar ao Portfólio Principal</a>
        </div>

        <div class="margin-note">
          <strong>CONTEÚDO:</strong>
          Projetos retirados do GitHub @obertobr.
        </div>
      </div>
    </aside>

    <main class="document-body">
      <header class="doc-header-block">
        <h1>Todos Projetos</h1>
      </header>

      <section aria-labelledby="sec-repos">
        <h2 id="sec-repos" class="section-title">
          <span>Repositórios</span>
          <span id="repo-count" style="color:var(--cyan); font-size:11px; font-weight:normal;">{countLabel}</span>
        </h2>

        <div id="filter-banner" class="filter-banner" style={targetLang ? 'display: flex;' : 'display: none;'}>
          <span>Filtrando por linguagem: <strong id="filter-badge" style="color:var(--cyan);">{rawLangFilter || ''}</strong></span>
          <a href="/projetos" class="filter-clear">× Limpar Filtro</a>
        </div>

        <table class="spec-table projects-table">
          <thead>
            <tr>
              <th style="width: 180px;">Repositório</th>
              <th style="width: 110px;">Linguagem</th>
              <th>Descrição do Escopo</th>
              <th style="width: 80px; text-align: right;">Código</th>
            </tr>
          </thead>
          <tbody>
            {sortedProjects.map((item) => {
              const isVisible = matchesLanguageFilter(item.language);
              return (
                <tr class="project-row" data-lang={item.language} style={isVisible ? '' : 'display: none;'}>
                  <td class="proj-cell-name"><strong>{item.name}</strong></td>
                  <td class="proj-cell-lang">
                    <a href={`/projetos?lang=${encodeURIComponent(item.language)}`} class="lang-table-link" title={`Filtrar por ${item.language}`}>
                      {item.language}
                    </a>
                  </td>
                  <td class="proj-cell-desc">{item.description}</td>
                  <td class="proj-cell-link">
                    <a href={item.url} target="_blank" rel="noopener noreferrer">[GitHub ↗]</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

      </section>

    </main>

  </div>

  <script is:inline>
    (function () {
      if (!document.querySelectorAll || typeof URLSearchParams === 'undefined') return;

      function applyFilter() {
        var params = new URLSearchParams(window.location.search);
        var langParam = params.get('lang');
        var banner = document.getElementById('filter-banner');
        var badge = document.getElementById('filter-badge');
        var countEl = document.getElementById('repo-count');
        var rows = document.querySelectorAll('.project-row');

        if (!langParam) {
          if (banner) banner.style.display = 'none';
          for (var i = 0; i < rows.length; i++) {
            rows[i].style.display = '';
          }
          if (countEl) countEl.textContent = 'TOTAL: ' + rows.length + ' PROJETOS';
          return;
        }

        var targetLang = langParam.replace(/^\s+|\s+$/g, '').toLowerCase();
        var visibleCount = 0;
        var primaryLangs = ['javascript', 'typescript', 'rust', 'php', 'python'];

        for (var j = 0; j < rows.length; j++) {
          var row = rows[j];
          var rowLang = (row.getAttribute('data-lang') || '').replace(/^\s+|\s+$/g, '').toLowerCase();
          var match = false;
          if (targetLang === 'outros') {
            match = primaryLangs.indexOf(rowLang) === -1;
          } else {
            match = rowLang === targetLang;
          }

          if (match) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        }

        if (banner && badge) {
          badge.textContent = langParam;
          banner.style.display = 'flex';
        }

        if (countEl) {
          countEl.textContent = visibleCount + ' DE ' + rows.length + ' PROJETOS';
        }
      }

      if (window.addEventListener) {
        window.addEventListener('popstate', applyFilter);
      }
    })();
  </script>
</Layout>

<style>
  .filter-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111115;
    border: 1px solid var(--cyan);
    padding: 8px 12px;
    font-size: 11px;
    margin-bottom: 16px;
    color: #fff;
  }

  .filter-clear {
    color: var(--cyan);
    text-decoration: none;
    font-weight: bold;
    font-size: 11px;
    float: right;
  }

  @supports (display: flex) {
    .filter-clear {
      float: none;
    }
  }

  .filter-clear:hover {
    text-decoration: underline;
    color: #fff;
  }

  .lang-table-link {
    color: var(--cyan);
    text-decoration: none;
  }

  .lang-table-link:hover {
    text-decoration: underline;
  }

  .proj-cell-desc {
    color: var(--muted);
  }

  @media screen and (max-width: 680px) {
    .projects-table,
    .projects-table tbody,
    .projects-table tr,
    .projects-table td {
      display: block;
      width: 100% !important;
    }

    .projects-table thead {
      display: none;
    }

    .project-row {
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
    }

    .project-row:last-child {
      border-bottom: none;
    }

    .proj-cell-name {
      font-size: 13px;
      color: #fff;
      padding: 0 0 2px 0 !important;
      border: none !important;
    }

    .proj-cell-lang {
      font-size: 11px;
      padding: 0 0 6px 0 !important;
      border: none !important;
    }

    .proj-cell-desc {
      font-size: 12px;
      line-height: 1.55;
      color: var(--muted) !important;
      padding: 0 0 8px 0 !important;
      border: none !important;
    }

    .proj-cell-link {
      font-size: 11px;
      padding: 0 !important;
      border: none !important;
      display: flex !important;
      justify-content: flex-end !important;
    }
  }

  @media print {
    .filter-banner {
      display: none !important;
    }
  }
</style>
